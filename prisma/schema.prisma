generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  REMIXER
  USER
}

model User {
  id                  String               @id @default(uuid())
  email               String               @unique
  username            String               @unique
  passwordHash        String               @map("password_hash")
  role                Role                 @default(USER)
  hashedRefreshToken  String?              @map("hashed_refresh_token")
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  passwordResetTokens PasswordResetToken[]
  creditLedgerEntries CreditLedgerEntry[]
  orders              Order[]
  subscriptions       Subscription[]
  downloads           Download[]
  remixRequests       RemixRequest[]       @relation("RequestedByUser")
  assignedRemixRequests RemixRequest[]     @relation("AssignedToRemixer")
  remixerEarnings     RemixerEarning[]     @relation("UserRemixerEarnings")
  payoutRequests      PayoutRequest[]      @relation("UserPayoutRequests")
  producedTracks      Track[]              @relation("RemixerTracks")

  @@map("users")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

enum PlanType {
  MONTHLY
  YEARLY
  CREDITS_PACK
}

model Plan {
  id              String         @id @default(uuid())
  name            String
  description     String?
  type            PlanType
  price           Decimal        @db.Decimal(10, 2)
  durationDays    Int            @default(30) @map("duration_days")
  creditsIncluded Int            @default(0) @map("credits_included")
  benefitsJson    Json           @map("benefits_json")
  canRequestRemix Boolean        @default(false) @map("can_request_remix")
  isActive        Boolean        @default(true) @map("is_active")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")
  orders          Order[]
  subscriptions   Subscription[]

  @@map("plans")
}

enum CreditEntryType {
  PLAN_SUBSCRIPTION
  TOPUP_PURCHASE
  REMIX_DOWNLOAD
  REMIX_REQUEST
  REMIX_REQUEST_ESCROW
  REMIX_REQUEST_REFUND
  ADMIN_ADJUSTMENT
}

model CreditLedgerEntry {
  id           String          @id @default(uuid())
  userId       String          @map("user_id")
  amount       Int
  type         CreditEntryType
  description  String
  metadataJson Json?           @map("metadata_json")
  createdAt    DateTime        @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("credit_ledger_entries")
}

enum OrderStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  EXPIRED
}

model Order {
  id            String      @id @default(uuid())
  userId        String      @map("user_id")
  planId        String      @map("plan_id")
  amount        Decimal     @db.Decimal(10, 2)
  currency      String      @default("USD")
  status        OrderStatus @default(PENDING)
  paypalOrderId String?     @unique @map("paypal_order_id")
  metadataJson  Json?       @map("metadata_json")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan Plan @relation(fields: [planId], references: [id])

  @@index([userId])
  @@map("orders")
}

model Subscription {
  id                   String             @id @default(uuid())
  userId               String             @map("user_id")
  planId               String             @map("plan_id")
  paypalSubscriptionId String?            @unique @map("paypal_subscription_id")
  status               SubscriptionStatus @default(ACTIVE)
  currentPeriodStart   DateTime           @map("current_period_start")
  currentPeriodEnd     DateTime           @map("current_period_end")
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan Plan @relation(fields: [planId], references: [id])

  @@index([userId])
  @@map("subscriptions")
}

enum StemType {
  DRUMS
  BASS
  VOCALS
  SYNTHS
  INSTRUMENTS
  OTHER
}

model Genre {
  id        String   @id @default(uuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  tracks    Track[]
  remixRequests RemixRequest[]

  @@map("genres")
}

model Track {
  id               String   @id @default(uuid())
  title            String
  artist           String
  remixer          String?
  version          String?
  genreId          String   @map("genre_id")
  bpm              Int
  musicalKey       String   @map("musical_key")
  durationSeconds  Int      @map("duration_seconds")
  previewAudioUrl  String   @map("preview_audio_url")
  downloadAudioUrl String   @map("download_audio_url")
  coverImageUrl    String?  @map("cover_image_url")
  waveformJson     Json?    @map("waveform_json")
  creditCost       Int      @default(1) @map("credit_cost")
  isPublished      Boolean  @default(true) @map("is_published")
  remixerId        String?  @map("remixer_id")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  genre             Genre            @relation(fields: [genreId], references: [id])
  remixerUser       User?            @relation("RemixerTracks", fields: [remixerId], references: [id], onDelete: SetNull)
  stems             Stem[]
  downloads         Download[]
  fulfilledRequests RemixRequest[]
  earnings          RemixerEarning[]

  @@index([genreId])
  @@index([remixerId])
  @@index([bpm])
  @@index([musicalKey])
  @@index([isPublished])
  @@map("tracks")
}

model Stem {
  id         String   @id @default(uuid())
  trackId    String   @map("track_id")
  name       String
  type       StemType
  audioUrl   String   @map("audio_url")
  creditCost Int      @default(1) @map("credit_cost")
  createdAt  DateTime @default(now()) @map("created_at")

  track     Track      @relation(fields: [trackId], references: [id], onDelete: Cascade)
  downloads Download[]

  @@index([trackId])
  @@map("stems")
}

model Download {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  trackId      String?  @map("track_id")
  stemId       String?  @map("stem_id")
  costCredits  Int      @map("cost_credits")
  downloadedAt DateTime @default(now()) @map("downloaded_at")

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  track Track? @relation(fields: [trackId], references: [id], onDelete: Cascade)
  stem  Stem?  @relation(fields: [stemId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([trackId])
  @@index([stemId])
  @@map("downloads")
}

enum RemixRequestStatus {
  PENDING
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  REJECTED
  CANCELLED
}

enum FundingType {
  INCLUDED_IN_PLAN
  CREDITS_BOUNTY
}

model RemixRequest {
  id            String             @id @default(uuid())
  userId        String             @map("user_id")
  remixerId     String?            @map("remixer_id")
  trackId       String?            @map("track_id")
  genreId       String?            @map("genre_id")
  title         String
  artist        String
  referenceUrl  String?            @map("reference_url")
  desiredBpm    Int?               @map("desired_bpm")
  notes         String?
  fundingType   FundingType        @map("funding_type")
  bountyCredits Int                @default(0) @map("bounty_credits")
  status        RemixRequestStatus @default(PENDING)
  adminFeedback String?            @map("admin_feedback")
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")

  user           User   @relation("RequestedByUser", fields: [userId], references: [id], onDelete: Cascade)
  remixer        User?  @relation("AssignedToRemixer", fields: [remixerId], references: [id], onDelete: SetNull)
  deliveredTrack Track? @relation(fields: [trackId], references: [id], onDelete: SetNull)
  genre          Genre? @relation(fields: [genreId], references: [id], onDelete: SetNull)
  earnings       RemixerEarning[]

  @@index([userId])
  @@index([remixerId])
  @@index([trackId])
  @@index([genreId])
  @@index([status])
  @@index([fundingType])
  @@map("remix_requests")
}

enum RemixerEarningType {
  ROYALTY_DOWNLOAD
  REMIX_BOUNTY
  PAYOUT_DEDUCTION
  PAYOUT_REFUND
  PLATFORM_ADJUSTMENT
}

enum PayoutStatus {
  PENDING
  IN_REVIEW
  APPROVED
  PROCESSING
  COMPLETED
  REJECTED
  CANCELLED
}

enum PayoutMethod {
  PAYPAL
  BANK_TRANSFER
}

model RemixerEarning {
  id              String             @id @default(uuid())
  remixerId       String             @map("remixer_id")
  amountCredits   Decimal            @map("amount_credits") @db.Decimal(10, 2)
  type            RemixerEarningType
  trackId         String?            @map("track_id")
  requestId       String?            @map("request_id")
  payoutRequestId String?            @map("payout_request_id")
  description     String
  createdAt       DateTime           @default(now()) @map("created_at")

  remixer         User               @relation("UserRemixerEarnings", fields: [remixerId], references: [id], onDelete: Cascade)
  track           Track?             @relation(fields: [trackId], references: [id], onDelete: SetNull)
  request         RemixRequest?      @relation(fields: [requestId], references: [id], onDelete: SetNull)
  payoutRequest   PayoutRequest?     @relation(fields: [payoutRequestId], references: [id], onDelete: SetNull)

  @@index([remixerId])
  @@index([type])
  @@index([trackId])
  @@index([requestId])
  @@index([payoutRequestId])
  @@index([createdAt])
  @@map("remixer_earnings")
}

model PayoutRequest {
  id                 String           @id @default(uuid())
  remixerId          String           @map("remixer_id")
  creditsAmount      Decimal          @map("credits_amount") @db.Decimal(10, 2)
  amountFiat         Decimal          @map("amount_fiat") @db.Decimal(10, 2)
  currency           String           @default("USD")
  status             PayoutStatus     @default(PENDING)
  method             PayoutMethod
  destinationDetails Json             @map("destination_details")
  adminFeedback      String?          @map("admin_feedback")
  processedAt        DateTime?        @map("processed_at")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")

  remixer            User             @relation("UserPayoutRequests", fields: [remixerId], references: [id], onDelete: Cascade)
  earnings           RemixerEarning[]

  @@index([remixerId])
  @@index([status])
  @@index([createdAt])
  @@map("payout_requests")
}

